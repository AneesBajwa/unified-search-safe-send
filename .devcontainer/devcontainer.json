{
  "name": "unified-search-safe-send",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // Docker-in-Docker rather than docker-outside-of-docker: the test suite
    // starts its own Postgres via testcontainers, so the container needs a
    // daemon it actually controls.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.13" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    // The base image ships no SSH server, so `gh codespace ssh` fails with
    // "Please check if an SSH server is installed in the container" — which
    // means the CLI cannot drive the Codespace at all and everything has to go
    // through the browser terminal. Found by booting one rather than by reading
    // the config.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  "forwardPorts": [8080, 8081, 5173, 5433],
  "portsAttributes": {
    "8080": { "label": "api", "onAutoForward": "notify" },
    "8081": { "label": "worker", "onAutoForward": "silent" },
    "5173": { "label": "spa", "onAutoForward": "openPreview" },
    "5433": { "label": "postgres", "onAutoForward": "silent" }
  },

  "containerEnv": {
    // Codespaces forwards on HTTPS already, so no tunnel is needed here — the
    // OAUTH_TUNNEL_URL in contracts.md §3 is a local-only concern (Slack
    // rejects http://localhost redirect URLs outright).
    "RUN_WORKER_INLINE": "1",
    "DEV_ROUTES": "1",
    // 🔴 The forwarded SPA origin is NOT added here, and the reason is worth
    // recording: `${containerEnv:CODESPACE_NAME}` substitution runs *before*
    // Codespaces injects its own variables, so the value arrives as that
    // literal string and the API rejects every request the console makes.
    // Verified by booting a Codespace and reading the value back.
    //
    // `apps/api/main.py` derives it instead, from the variables that are
    // genuinely present in the login shell the API is started from.
    "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },

  "onCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh",
  // 🔴 The keyring is generated here, and only here.
  //
  // `.env.example` ships `TOKEN_KEYRING=` empty — it is committed, so it cannot
  // contain key material — and every route that touches a credential fails
  // without one. A reviewer who follows the README (`cp .env.example .env`,
  // bring the stack up, click Connect) otherwise meets a failure on the first
  // meaningful thing they do.
  //
  // Generated rather than defaulted, and *only* in a devcontainer: `risks.md`
  // R9 forbids a generate-if-missing path in the app itself, because a key that
  // appears by magic means a later restart silently cannot decrypt what the
  // earlier one wrote. Here the container is disposable and so is the key.
  "postCreateCommand": "$HOME/.local/bin/uv sync --all-extras && (cd apps/web && npm install) && ([ -f .env ] || cp .env.example .env) && (grep -q '^TOKEN_KEYRING=.\\+' .env || (sed -i \"s|^TOKEN_KEYRING=.*|TOKEN_KEYRING=$(python3 -c 'import os,base64;print(base64.b64encode(os.urandom(32)).decode())')|\" .env && echo 'generated a disposable TOKEN_KEYRING for this devcontainer'))",

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },

  "remoteUser": "vscode"
}
