# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Full cross-environment matrix: openspec contracts.md §3.

# ---------- database ----------
# Local: the compose postgres, published on host port 5433 to stay clear of a
# natively-installed Postgres on 5432. Cloud Run: Neon POOLED endpoint
# (-pooler host), supplied via Secret Manager, never checked in.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app

# ---------- app ----------
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# ---------- token encryption (phase 1+) ----------
# 32 random bytes, base64. Generate:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# The dev key is NEVER the production key. A developer restoring a production
# dump gets KeyNotFound on every row — that is the protection working.
# On Cloud Run this is a Secret Manager VOLUME MOUNT at /secrets/keyring,
# not an env var: env vars resolve at instance start (so rotation forces a
# redeploy) and leak through /proc/self/environ and subprocess environments.
TOKEN_KEYRING=

# ---------- providers (phase 3+) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Slack rejects http://localhost redirect URLs outright — an HTTPS tunnel is
# a prerequisite for any local Slack OAuth work, not an optimisation.
OAUTH_TUNNEL_URL=

# Unset => the web adapter serves a deterministic fixture set and reports
# mode: "mock", which the UI badges. Tests always run against the mock.
WEB_SEARCH_API_KEY=

# ---------- runtime knobs ----------
# 1 locally and in Codespaces so `docker compose up` stays one command;
# 0 on Cloud Run, where work is pushed via Cloud Tasks (design D4).
RUN_WORKER_INLINE=1
SLOW_ADAPTER_DELAY_MS=0
SLOW_ADAPTER_SOURCE=
JOB_LEASE_SECONDS=90
SEND_LEASE_SECONDS=300
ADAPTER_DEADLINE_SECONDS=30
MAX_ATTEMPTS=6
